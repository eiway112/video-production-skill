# ===== OpenMontage 环境变量配置 =====
# 优先级说明：标注 [必填] 的为免费工具，可直接获取 Key 后填入
#            标注 [可选] 的为付费/高级工具，不填不影响基础功能

# ===== [必填] 免费库存素材 =====
# 注册即可免费获取 API Key，用于素材搜索
# Pexels: https://www.pexels.com/api/ (免费)
PEXELS_API_KEY=your_free_pexels_key
# Pixabay: https://pixabay.com/api/docs/ (免费)
PIXABAY_API_KEY=your_free_pixabay_key
# Unsplash: https://unsplash.com/developers (免费 Developer Key)
UNSPLASH_ACCESS_KEY=your_free_unsplash_key

# ===== [可选] TTS 语音合成 =====
# Google Cloud TTS — 700+ 声音，50+ 语言
# 获取: https://aistudio.google.com/apikey (有免费额度)
GOOGLE_API_KEY=your_google_cloud_api_key
# ElevenLabs — 高质量 AI 语音 (付费)
# ELEVENLABS_API_KEY=your_key
# OpenAI TTS (付费)
# OPENAI_API_KEY=your_key
# Doubao TTS — 火山引擎 (国内推荐)
# DOUBAO_SPEECH_API_KEY=your_key
# DOUBAO_SPEECH_VOICE_TYPE=zh_female_vv_uranus_bigtts
# Qwen-Audio TTS / CosyVoice — 阿里云百炼 (中文质量登顶，国内网络稳定)
# 获取: https://bailian.console.aliyun.com/ → API-KEY 管理
# ⚠️ 不要将真实 Key 提交入库——用 shell 环境变量或 openmontage.env.local（.gitignore 已保护）
DASHSCOPE_API_KEY=<在此填入你的DashScope API Key，或使用 openmontage.env.local 覆盖（推荐）>
# HyperFrames 默认音色（2026-08-06 升级）：longanling_v3 (龙安灵V3、思维灵动女、cosyvoice-v3-flash)
# 其他可选音色：longanwen(优雅知性女 v2)、longanzhi(睿智轻熟男 v2)、longcheng_v3(智慧青年男) 等
# 情感控制（Instruct）音色：longanyang(阳光大男孩)/longanhuan(欢脱元气女)，搭配 config tts_instruction 使用
# QWEN_TTS_VOICE=longanling_v3
# QWEN_TTS_MODEL=cosyvoice-v3-flash  # 2026-08-06 实测：v3 系列走标准 dashscope 端点即可，无需专属域名
# Piper TTS — 完全本地，无需 API Key，pip install piper-tts

# ===== HyperFrames 流水线的 TTS 默认已切换为 Qwen (cosyvoice-v3-flash + longanling_v3) =====
# 切回 Edge-TTS：在项目 config.json 里声明 "tts_engine": "edge"（仅限存量项目；新项目禁用）
# Edge-TTS 无需 API Key；Qwen 需 DASHSCOPE_API_KEY（上方已配置）。
# OpenMontage 的 animated-explainer 路由往期使用 edge-tts，如需同步切 Qwen 另行适配。

# ===== [可选] 图像/视频生成 =====
# FAL.ai — FLUX 图像 + 多种视频模型 (付费)
# FAL_KEY=your_key
# Runway Gen-4 (付费)
# RUNWAY_API_KEY=your_key
# Grok 图像/视频生成 (xAI)
# XAI_API_KEY=your_key
# 本地视频生成 (需 GPU)
# VIDEO_GEN_LOCAL_ENABLED=true
# VIDEO_GEN_LOCAL_MODEL=wan2.1-1.3b

# ===== [可选] 音乐生成 =====
# Suno AI (付费)
# SUNO_API_KEY=your_key
# Pixabay Music (免费，共用 PIXABAY_API_KEY)

# ===== [可选] 转录/分析 =====
# HuggingFace Token — 用于说话人分离 (免费注册)
# 获取: https://huggingface.co/settings/tokens
# HF_TOKEN=your_hf_token
# OpenAI Whisper 本地转录: pip install openai-whisper (免费，无需 Key)

# ===== 渲染引擎 =====
# remotion: React 帧精确渲染 (默认，Node.js 必需)
# ffmpeg: FFmpeg 直接拼接 (轻量，无 Node.js 依赖)
# hyperframes: HTML+GSAP 渲染 (需 Chrome headless)
RENDER_RUNTIME=remotion

# ===== 预算控制 =====
DEFAULT_BUDGET_CAP=10.0
ENABLE_COST_TRACKING=true
WARN_ON_COST_EXCEED=0.8

# ===== 日志 =====
LOG_LEVEL=INFO
ENABLE_DECISION_LOG=true

# ===== 本地化 =====
LANGUAGE=zh-CN
TIMEZONE=Asia/Shanghai
